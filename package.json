{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-preview.mjs",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=build/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist build",
    "lint": "tsc --noEmit",
    "start": "node scripts/start.mjs",
    "emulators": "node scripts/local-environment.mjs emulators",
    "test": "node scripts/run-unit-tests.mjs",
    "test:firebase": "node scripts/local-environment.mjs test",
    "seed:local": "node --require ./scripts/local-only-network.cjs --import tsx scripts/seed-emulator.ts",
    "test:browser": "node scripts/browser-isolation.mjs",
    "test:auth": "node scripts/local-environment.mjs auth-test",
    "test:backup": "node scripts/test-backup.mjs",
    "test:phase-a": "node scripts/phase-a-browser.mjs",
    "test:provider": "node scripts/provider-synthetic-browser.mjs",
    "evaluate:duration": "node --require ./scripts/local-only-network.cjs --import tsx scripts/evaluate-estimator.ts",
    "evaluate:retention": "node --require ./scripts/local-only-network.cjs --import tsx scripts/evaluate-retention.ts",
    "test:release": "node --require ./scripts/local-only-network.cjs --import tsx --test scripts/release-regression-probes.ts",
    "dev:local": "node scripts/local-environment.mjs dev",
    "test:hosted-preview": "node scripts/test-hosted-preview.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.1",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.5.0",
    "papaparse": "^5.7.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "uuid": "^14.0.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@babel/core": "^8.0.5",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@playwright/test": "1.58.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@types/papaparse": "^5.5.2",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "firebase-tools": "15.35.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~5.8.2",
    "vite": "^6.4.6"
  },
  "engines": {
    "node": ">=24.11.0 <25",
    "npm": ">=11"
  },
  "overrides": {
    "dompurify": "^3.4.17",
    "websocket-driver": "^0.7.5",
    "protobufjs": "^7.6.6",
    "@grpc/grpc-js": "^1.14.7",
    "qs": "^6.17.1",
    "browserslist": "^4.29.5",
    "brace-expansion@^5.0.0": "^5.0.13"
  }
}
