rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function pathOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function owned(data) {
      return signedIn() && safeOwnerFields(data, request.auth.uid) && (
        ('userId' in data && data.userId == request.auth.uid) ||
        ('uid' in data && data.uid == request.auth.uid) ||
        ('user_id' in data && data.user_id == request.auth.uid)
      );
    }
    function safeOwnerFields(data, uid) {
      return (!('userId' in data) || data.userId == uid) &&
        (!('uid' in data) || data.uid == uid) &&
        (!('user_id' in data) || data.user_id == uid);
    }
    match /users/{uid} {
      allow read, delete: if pathOwner(uid);
      allow create, update: if pathOwner(uid) && safeOwnerFields(request.resource.data, uid);
      match /{document=**} {
        allow read, delete: if pathOwner(uid);
        allow create, update: if pathOwner(uid) && safeOwnerFields(request.resource.data, uid);
      }
    }
    // Legacy UID-owned documents remain readable; ownership may never be claimed
    // from a proposed update, an unverified email or an ownerless document.
    match /{collection}/{id} {
      allow read, delete: if collection in ['progress','sessions','study_sessions','cante_sessions','cantos','cantes','user_sessions','user_settings'] && owned(resource.data);
      allow create: if collection in ['progress','sessions','study_sessions','cante_sessions','cantos','cantes','user_sessions','user_settings'] && owned(request.resource.data) && safeOwnerFields(request.resource.data, request.auth.uid);
      allow update: if collection in ['progress','sessions','study_sessions','cante_sessions','cantos','cantes','user_sessions','user_settings'] && owned(resource.data) && safeOwnerFields(request.resource.data,request.auth.uid) && safeOwnerFields(resource.data,request.auth.uid);
    }
    // Backend credentials and quotas are available only through the authenticated
    // server. Admin SDK bypasses rules; server handlers must enforce UID too.
    match /{document=**} { allow read, write: if false; }
  }
}
