# Local development: npm run dev supplies demo-only emulators automatically.
# No production credential is needed for tests. Never commit a real .env file.
VITE_FIREBASE_MODE=emulator
VITE_FIREBASE_PROJECT_ID=demo-wellsprep
VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_SERVER_MODE=emulator
FIREBASE_PROJECT_ID=demo-wellsprep
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Remote deployment (configure outside Git; do not enable these in local tests):
# Build: VITE_FIREBASE_MODE=production
# Browser configuration: firebase-applet-config.json, public web config only.
# Runtime: FIREBASE_SERVER_MODE=production, FIREBASE_ALLOW_REMOTE=true,
# FIREBASE_PROJECT_ID and FIREBASE_DATABASE_ID must match that browser config.
# Remove both emulator-host variables. Use managed service identity/ADC, never
# upload an administrator JSON key. PORT is supplied by the hosting platform.
# GEMINI_API_KEY is an optional SERVER secret for PDF import, not a VITE variable.
# AEROFOCUS_ALLOWED_ORIGINS=https://your-aerofocus.example
# VITE_AEROFOCUS_ALLOWED_ORIGINS=https://your-aerofocus.example
# External AeroFocus: generate a personal credential in Settings; send it as
# X-Webhook-Token to the authenticated service. The former shared token is invalid.
